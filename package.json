    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@oxc-node/core": "^0.1.3",
    "@types/node": "^26.6.2",
    "@voidzero-dev/vite-plus-core": "^1.0.0-rc.1",
