{
  "name": "@lib/module",
  "version": "0.0.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "napi build --platform --esm",
    "build:release": "napi build --platform --release --esm",
    "build:js": "vp pack",
    "dev": "vp pack --watch",
    "start": "vp run src/main.ts",
    "test": "npx vp test src/main.test.ts && node --test test.mjs",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.5",
    "@types/node": "^26.6.2",
    "vite-plus": "^1.0.0-rc.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1"
  },
  "napi": {
    "binaryName": "my-addon"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.11.0",
      "onFail": "download"
    }
  }
}
